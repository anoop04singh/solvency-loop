{
  "name": "solvency-loop",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-memwal.mjs",
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "move:build": "sui move build --path move/solvency_loop --build-env mainnet",
    "move:test": "sui move test --path move/solvency_loop --build-env mainnet",
    "move:verify-bundle": "node scripts/verify-move-bundle.mjs",
    "verify:mainnet": "tsx scripts/verify-mainnet-readiness.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "rpc:bridge": "node scripts/tatum-rpc-bridge.mjs"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "0.1.11",
    "@mysten/dapp-kit": "1.1.17",
    "@mysten/sui": "2.38.0",
    "@mysten/seal": "1.5.2",
    "@mysten/walrus": "1.2.37",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "dotenv": "^17.0.0",
    "tsx": "^4.20.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.28"
  },
  "overrides": {
    "postcss": "$postcss",
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
