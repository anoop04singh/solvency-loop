# Copy to .env.local. Never commit .env.local or private keys.
TATUM_API_KEY=
# Optional public origin behind a hosting proxy, e.g. https://your-app.example
APP_ORIGIN=
NEXT_PUBLIC_TATUM_SUI_RPC=https://sui-mainnet.gateway.tatum.io

# Fill after publishing move/solvency_loop on Sui Mainnet.
NEXT_PUBLIC_SOLVENCY_PACKAGE_ID=
NEXT_PUBLIC_SOLVENCY_REGISTRY_ID=

# Shared Mainnet protocol IDs and the app's server delegate.
# Each user's account is discovered on chain; no global account ID is used.
MEMWAL_DELEGATE_PRIVATE_KEY=
# Raw 32-byte public key matching the private delegate above, with 0x prefix.
NEXT_PUBLIC_MEMWAL_AGENT_ID=
NEXT_PUBLIC_MEMWAL_PACKAGE_ID=
NEXT_PUBLIC_MEMWAL_REGISTRY_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Optional manual-mode credentials stay SERVER-ONLY.
# Never use NEXT_PUBLIC_* for private keys or OpenAI credentials.
OPENAI_API_KEY=

# Real canonical 0x + 64-hex Sui wallet addresses, or enter these in the UI.
NEXT_PUBLIC_ALEX_SUI_WALLET=
NEXT_PUBLIC_PRIYA_SUI_WALLET=
NEXT_PUBLIC_SAM_SUI_WALLET=

# A wallet whose namespaces hold >=10 memories, for the readiness script.
VERIFY_WALLET_ADDRESS=
